<Application x:Class="GymnasieProjekt.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GymnasieProjekt.WPF.ViewModels"
             xmlns:views="clr-namespace:GymnasieProjekt.WPF.Views">
    <Application.Resources>
        <!-- Tells WPF which View to show for each ViewModel -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentsViewModel}">
            <views:StudentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentListViewModel}">
            <views:StudentListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentViewModel}">
            <views:StudentView/>
        </DataTemplate>
    </Application.Resources>
</Application>
