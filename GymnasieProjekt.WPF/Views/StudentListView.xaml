<UserControl x:Class="GymnasieProjekt.WPF.Views.StudentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:GymnasieProjekt.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StudentListViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- The list fills the page; the search field sits under it -->
    <DockPanel Margin="10">

        <TextBlock DockPanel.Dock="Top" Text="Alle elever:" Margin="0,0,0,4"/>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="Søg efter elev:" Margin="0,0,0,4"/>

            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="4"/>

            <Popup IsOpen="{Binding IsDropDownOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=SearchBox}"
                   Placement="Bottom"
                   Width="{Binding ActualWidth, ElementName=SearchBox}"
                   StaysOpen="False">
                <ListBox ItemsSource="{Binding SearchResults}"
                         SelectedItem="{Binding SelectedSearchResult}"
                         DisplayMemberPath="DisplayName"
                         MaxHeight="200"/>
            </Popup>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Fills the space that's left; scrolls when there are many students -->
        <ListBox ItemsSource="{Binding AllStudents}"
                 SelectedItem="{Binding SelectedStudent}"
                 DisplayMemberPath="DisplayName"/>
    </DockPanel>
</UserControl>
